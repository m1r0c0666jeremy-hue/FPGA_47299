# Pin constraints for HX1P35A (KX-SOC) - PH1P35MDG324
# Verified against "New HX1P35A Development Board Manual (HDL), 2026-04 rev."
# Modified from vendor Lab1: reset / buttons / status PWM only.
# Keep this file in sync with docs: see ../docs/接线与验收.md

set_pin_assignment	{ I_sys_clk }			{ LOCATION = C4; IOSTANDARD  = LVCMOS33; PULLTYPE = PULLUP; }   # manual p6: CLK = C4

# --- reset: board KEY1 (active low, on-board 10K pull-up to 3V3).  Lab1 used R10 = RGMII_TX_CTL (Ethernet)
set_pin_assignment	{ I_rst_n }				{ LOCATION = D5; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }   # manual p23: KEY1 = D5

# --- camera: manual p13 MIPI_CSI table (identical to vendor Lab1, unchanged)
set_pin_assignment	{ O_cam_scl }		{ LOCATION = K3; IOSTANDARD  = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }  # MIPI_CSI_I2C_FSCL
set_pin_assignment	{ IO_cam_sda }		{ LOCATION = J3; IOSTANDARD  = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }  # MIPI_CSI_I2C_FSDA
set_pin_assignment	{ O_cam_24m }		{ LOCATION = L3; IOSTANDARD  = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }  # MIPI_CSI_FCLK (23.81 MHz)
set_pin_assignment	{ O_cam_rst }		{ LOCATION = L2; IOSTANDARD  = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }  # MIPI_CSI_FPWDNB

# --- buttons: board keys (active low, 10K pull-up).  Lab1 used N2/J14 = J2.22 / J1.15 (expansion headers)
# NOTE: input ports must NOT carry DRIVESTRENGTH (TD: USR-8409).
set_pin_assignment	{ I_button[0] }		{ LOCATION = A9;  IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }  # manual p23: KEY2 = A9
set_pin_assignment	{ I_button[1] }		{ LOCATION = B9;  IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }  # manual p23: KEY3 = B9
# KEY4 = C7 added below

# --- status / heartbeat: board LED1 (active high).  Lab1 used R11 = RGMII_TXD[0] (Ethernet)
set_pin_assignment	{ O_screen_pwm }	{ LOCATION = D10; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }   # manual p20: LED1 = D10

# --- HDMI: manual p14/p15 table (identical to vendor Lab1, unchanged)
set_pin_assignment	{ O_tmds_ch0_p }	{ LOCATION = G16; IOSTANDARD = TMDS33; PULLTYPE = NONE; }   # HDMI1_D0_P
set_pin_assignment	{ O_tmds_ch1_p }	{ LOCATION = F17; IOSTANDARD = TMDS33; PULLTYPE = NONE; }   # HDMI1_D1_P
set_pin_assignment	{ O_tmds_ch2_p }	{ LOCATION = H14; IOSTANDARD = TMDS33; PULLTYPE = NONE; }   # HDMI1_D2_P
set_pin_assignment	{ O_tmds_clk_p }	{ LOCATION = C17; IOSTANDARD = TMDS33; PULLTYPE = NONE; }   # HDMI1_CLK_P (N = D18)

# HX1P35A manual p21: SW1=A4, SW2=B4; measured SW1/2 up=0, down=1. Mode order SW1,SW2.
set_pin_assignment { I_switch[1] } { LOCATION = A4; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment { I_switch[0] } { LOCATION = B4; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }

# ScalingTest: added board controls; confirm SW3/4 physical direction on board.
set_pin_assignment { I_button[2] } { LOCATION = C7; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment { I_ui_switch[1] } { LOCATION = E11; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment { I_ui_switch[0] } { LOCATION = D11; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
